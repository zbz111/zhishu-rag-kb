# ===== 基础 =====
APP_NAME=企业知识库问答系统
DEBUG=false
HOST=127.0.0.1
PORT=8000

# ===== 安全（生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(48))"）=====
SECRET_KEY=change-me-in-production-please-use-a-random-string
ACCESS_TOKEN_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ALLOW_REGISTER=false

# ===== 数据库 =====
# SQLite（默认，零依赖）
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL（可选）
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/ragdb

# ===== 模型服务 =====
# ollama：本地免费，断网可用；openai：DeepSeek / 通义 / vLLM 等兼容接口
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# DeepSeek 示例
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-xxxx
# OPENAI_CHAT_MODEL=deepseek-chat

# 硅基流动 embedding（可选，中文效果好）
# OPENAI_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_EMBED_API_KEY=sk-xxxx
# OPENAI_EMBED_MODEL=BAAI/bge-m3

# ===== 检索参数 =====
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=6
CANDIDATE_K=20
ENABLE_HYBRID=true
ENABLE_RERANK=false

# ===== 生成参数 =====
TEMPERATURE=0.1
MAX_TOKENS=1200
HISTORY_TURNS=3

# ===== 限额 =====
MAX_UPLOAD_MB=30
MAX_QUESTIONS_PER_DAY=300
RATE_LIMIT_PER_MINUTE=20

EMBED_BATCH_SIZE=10

SIMILARITY_RATIO=0.82
